# PolicyServer容器 - 模拟易受攻击的LeRobot PolicyServer
FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    openssh-server \
    openssh-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装gRPC依赖
RUN pip install --no-cache-dir \
    grpcio \
    grpcio-tools \
    protobuf

# 创建工作目录
WORKDIR /opt

# 创建SSH目录
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh

CMD ["python3", "/opt/policy_server.py"]
