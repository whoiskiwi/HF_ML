# 攻击者容器 - 包含必要的工具进行gRPC利用
FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    openssh-client \
    netcat-traditional \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# 安装gRPC和相关依赖
RUN pip install --no-cache-dir \
    grpcio \
    grpcio-tools \
    protobuf

# 创建工作目录
WORKDIR /opt

# 复制exploit脚本在启动时会被挂载
CMD ["/bin/bash"]
